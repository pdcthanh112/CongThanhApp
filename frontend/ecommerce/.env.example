# Gateway APISIX: /graphql (Cosmo Router, supergraph storefront) và /api/ecommerce/* (REST: search, supplier, media...)
NEXT_PUBLIC_GATEWAY_URL=http://localhost:9080
# Ghi đè riêng nếu router không nằm sau gateway
# NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql

# Đăng nhập Keycloak (client public "storefront-web" + PKCE, có sẵn trong realm). Google/Facebook/Apple cấu hình trong Keycloak.
KEYCLOAK_ISSUER=http://localhost:8180/realms/ecommerce
KEYCLOAK_CLIENT_ID=storefront-web
# Để trống với public client
KEYCLOAK_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
