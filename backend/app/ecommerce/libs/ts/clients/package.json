{
  "name": "@ecom/clients",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Client tới các service Java/Go (gRPC qua Connect, REST có kiểm tra kiểu) dùng chung cho storefront-bff và backoffice-bff",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@connectrpc/connect": "^2.3.0",
    "@ecom/platform": "0.1.0",
    "@ecom/proto": "0.1.0",
    "@ecom/shared": "0.1.0",
    "zod": "^4.6.7"
  }
}
