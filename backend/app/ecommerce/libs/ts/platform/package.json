{
  "name": "@ecom/platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Khối nền cho service NestJS: cấu hình, OTel, log, xác thực Keycloak, Postgres/Drizzle + outbox, Kafka consumer chống trùng, gRPC (Connect), GraphQL Federation, health",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./telemetry": {
      "source": "./src/telemetry/register.ts",
      "types": "./dist/telemetry/register.d.ts",
      "default": "./dist/telemetry/register.js"
    },
    "./testing": {
      "source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./errors": {
      "source": "./src/errors/domain-error.ts",
      "types": "./dist/errors/domain-error.d.ts",
      "default": "./dist/errors/domain-error.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@apollo/subgraph": "^2.15.1",
    "@as-integrations/express5": "^1.1.2",
    "@bufbuild/protobuf": "^2.17.0",
    "@confluentinc/kafka-javascript": "^1.11.0",
    "@connectrpc/connect": "^2.3.0",
    "@connectrpc/connect-node": "^2.3.0",
    "@ecom/proto": "0.1.0",
    "@ecom/shared": "0.1.0",
    "@nestjs/apollo": "^14.2.0",
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/graphql": "^14.2.0",
    "@nestjs/platform-express": "^12.4.2",
    "@nestjs/terminus": "^12.1.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.301.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.301.1",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.1",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "cockatiel": "^4.0.0",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "graphql": "^16.15.0",
    "graphql-ws": "^6.4.1",
    "helmet": "^8.3.0",
    "iovalkey": "^0.4.0",
    "jose": "^6.2.16",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.3",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1"
  }
}
