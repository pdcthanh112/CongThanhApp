{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "libs/ts/**",
      "services/*-bff/**",
      "services/catalog-service/**",
      "services/customer-service/**",
      "services/review-service/**",
      "services/notification-service/**",
      "services/message-service/**",
      "!**/dist",
      "!**/gen",
      "!**/drizzle/meta",
      "!**/schema.graphql"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "always", "trailingCommas": "all" },
    "parser": { "unsafeParameterDecoratorsEnabled": true }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": { "useImportType": "off", "noNonNullAssertion": "off", "noParameterProperties": "off" },
      "suspicious": { "noExplicitAny": "error" },
      "complexity": { "noStaticOnlyClass": "off" }
    }
  }
}
