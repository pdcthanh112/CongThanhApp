HTTP_ADDR=:5023
DATABASE_URL=postgres://postgres:123456@localhost:5432/CongThanhApp-Ecommerce?sslmode=disable
DB_SCHEMA=webhook
KAFKA_BROKERS=localhost:29092
# true chỉ khi dev: cho URL http:// và IP nội bộ (localhost, 10.x...)
WEBHOOK_ALLOW_INSECURE=true
WEBHOOK_SEND_TIMEOUT=10s
# Xác thực JWT: chọn một trong hai. Bỏ trống cả hai = tắt xác thực (chỉ dùng khi dev).
JWT_JWKS_URL=
JWT_SECRET=
JWT_ISSUER=
LOG_FORMAT=text
LOG_LEVEL=info
