HTTP_PORT=5024
# anthropic (Claude API) | ollama (model tự host, chạy `docker compose --profile ollama up`)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral
SEARCH_URL=http://localhost:5013
PRODUCT_CONTEXT_SIZE=5
VALKEY_URL=redis://localhost:6379/6
HISTORY_TURNS=10
HISTORY_TTL_SECONDS=86400
MAX_MESSAGE_CHARS=2000
STORE_NAME=CongThanh Shop
JWT_JWKS_URL=
JWT_ISSUER=
LOG_FORMAT=text
LOG_LEVEL=info
