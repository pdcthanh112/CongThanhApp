HTTP_ADDR=:5007
DATABASE_URL=postgres://postgres:123456@localhost:5432/CongThanhApp-Ecommerce?sslmode=disable
DB_SCHEMA=media
# MinIO local (deploy/local); AWS: bỏ trống endpoint/access key để dùng IRSA hoặc profile
S3_ENDPOINT=http://localhost:9000
S3_PATH_STYLE=true
S3_BUCKET=ecommerce-media
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
MEDIA_PUBLIC_URL=http://localhost:9000/ecommerce-media/
MEDIA_UPLOAD_TTL=15m
MEDIA_PENDING_TTL=24h
# Xác thực JWT: chọn một trong hai. Bỏ trống cả hai = tắt xác thực (chỉ dùng khi dev).
JWT_JWKS_URL=
JWT_SECRET=
JWT_ISSUER=
LOG_FORMAT=text
LOG_LEVEL=info
