// CI chính là GitHub Actions (.github/workflows/ci-java.yml); Jenkinsfile giữ cho môi trường Jenkins nội bộ.
pipeline {
    agent any
    stages {
        stage('Build') {
            steps {
                dir('backend/app/ecommerce') {
                    sh './gradlew :services:product-service:build --no-daemon'
                }
            }
        }
        stage('Docker Build') {
            steps {
                dir('backend/app/ecommerce') {
                    sh 'docker build -f services/product-service/Dockerfile -t congthanhapp/product-service .'
                }
            }
        }
        stage('Deploy') {
            steps {
                dir('backend/app/ecommerce/services/product-service') {
                    sh 'docker compose up -d'
                }
            }
        }
    }
}
