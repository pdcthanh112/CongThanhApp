HTTP_PORT=5017
# Khoá API Claude (ở cluster lấy từ Vault qua ExternalSecret).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
VALKEY_URL=redis://localhost:6379/5
CACHE_TTL_SECONDS=2592000
MAX_TEXTS=50
MAX_CHARS=20000
# Keycloak: JWT_JWKS_URL=http://localhost:8180/realms/congthanhapp/protocol/openid-connect/certs
# Bỏ trống = tắt xác thực (dev, dùng header X-User-Id).
JWT_JWKS_URL=
JWT_ISSUER=
LOG_FORMAT=text
LOG_LEVEL=info
