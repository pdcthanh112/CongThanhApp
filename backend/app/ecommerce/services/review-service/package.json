{
  "name": "@ecom/review-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Đánh giá sản phẩm có xác minh đã mua, điểm tổng hợp, phản hồi của seller, kiểm duyệt: GraphQL subgraph (mở rộng Product)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --enable-source-maps --import @ecom/platform/telemetry dist/main.js",
    "migrate": "node dist/migrate.js",
    "db:generate": "drizzle-kit generate",
    "schema:emit": "node dist/emit-schema.js"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@connectrpc/connect": "^2.3.0",
    "@ecom/platform": "0.1.0",
    "@ecom/proto": "0.1.0",
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/graphql": "^14.2.0",
    "dataloader": "^2.2.3",
    "drizzle-orm": "^0.45.4",
    "graphql": "^16.15.0",
    "reflect-metadata": "^0.2.2",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  }
}
