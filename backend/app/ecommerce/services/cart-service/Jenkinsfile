// CI chính là GitHub Actions (.github/workflows/ci-go.yml); Jenkinsfile giữ cho môi trường Jenkins nội bộ.
pipeline {
    agent any
    stages {
        stage('Test') {
            steps {
                dir('backend/app/ecommerce/services/cart-service') {
                    sh 'go vet ./... && go test ./...'
                }
            }
        }
        stage('Docker Build') {
            steps {
                dir('backend/app/ecommerce') {
                    sh 'docker build -f services/cart-service/Dockerfile -t congthanhapp/cart-service:${BUILD_NUMBER} .'
                }
            }
        }
    }
}
